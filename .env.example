# Optional public site-verification tokens; rebuild after setting on the hosting provider.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Set SITE_INDEXABLE=false for preview/staging on hosts without VERCEL_ENV.
# Vercel preview/development and next dev are automatically non-indexable.
# Production canonical; normally leave unset.
# NEXT_PUBLIC_SITE_URL=https://www.cascondigital.com

# Set only when the CRO Worker is deployed and verified on Workers Free.
# NEXT_PUBLIC_CRO_WORKER_URL=https://cascon-cro-audit.YOUR-SUBDOMAIN.workers.dev
