# Optional public site-verification tokens; rebuild after setting on the hosting provider.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Set SITE_INDEXABLE=false for preview/staging on hosts without VERCEL_ENV.
# Vercel preview/development and next dev are automatically non-indexable.
# Production canonical; normally leave unset.
# NEXT_PUBLIC_SITE_URL=https://www.cascondigital.com

# Production uses the same-origin /api/cro/scan endpoint.
# CRO_WORKER_URL=https://cascon-cro-audit.YOUR-SUBDOMAIN.workers.dev
# CRO_RELAY_SECRET=  Set the same secret on Vercel and the production Worker.
# NEXT_PUBLIC_CRO_TURNSTILE_SITE_KEY=
# Optional direct Worker origin for an isolated preview.
# NEXT_PUBLIC_CRO_WORKER_URL=http://localhost:8787
